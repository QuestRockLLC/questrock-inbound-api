{
  "rewrites": [
    { "source": "/api/zoom-call", "destination": "/api/call-answered" },
    { "source": "/api/mailer-lo/my-leads", "destination": "/api/mailer-lo?action=my-leads" },
    { "source": "/api/mailer-lo/search", "destination": "/api/mailer-lo?action=search" },
    { "source": "/api/mailer-lo/lead", "destination": "/api/mailer-lo?action=lead" },
    { "source": "/api/mailer-lo/assign", "destination": "/api/mailer-lo?action=assign" },
    { "source": "/api/mailer-lo/roster", "destination": "/api/mailer-lo?action=roster" },
    { "source": "/api/mailer-lo/campaign", "destination": "/api/mailer-lo?action=campaign" },
    { "source": "/api/shape-archive/export", "destination": "/api/import-mailer-list?resource=shape-archive" }
  ],
  "functions": {
    "api/zoom-transcript.js": {
      "maxDuration": 300
    },
    "api/call-tracker-link-mailer.js": {
      "maxDuration": 300
    },
    "api/call-tracker-paste-transcript.js": {
      "maxDuration": 300
    },
    "api/call-tracker-analyze.js": {
      "maxDuration": 300
    },
    "api/call-tracker-refetch.js": {
      "maxDuration": 300
    },
    "api/questmail-backfill.js": {
      "maxDuration": 300
    },
    "api/call-answered.js": {
      "maxDuration": 60
    },
    "api/call-tracker-weekly-report.js": {
      "maxDuration": 60
    },
    "api/call-tracker-manage.js": {
      "maxDuration": 30
    },
    "api/questmail-weekly-report.js": {
      "maxDuration": 60
    },
    "api/lo-note.js": {
      "maxDuration": 60
    },
    "api/import-mailer-list.js": {
      "maxDuration": 300
    },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/shape-lead-sync.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/shape-lead-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/call-tracker-weekly-report?kind=monday",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/call-tracker-weekly-report?kind=friday",
      "schedule": "0 21 * * 5"
    },
    {
      "path": "/api/questmail-weekly-report?kind=monday",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/questmail-weekly-report?kind=friday",
      "schedule": "0 21 * * 5"
    }
  ]
}
