# TRANSCRIPT_ADMIN_EMAILS=arashid@questrock.com
# OPENAI_DEAL_REVIEW_MODEL=gpt-4o-mini

# Thursday mailer import — Shape Marketing Source "Mail" (not Inbound Zoom Phone)
# Post URL: Settings → Sales & Marketing → Marketing Sources → Mail
SHAPE_POST_LEAD_URL=https://secure-api.setshape.com/postlead/20931/21580
# URL path source id (21580) if SHAPE_POST_LEAD_URL is unset:
SHAPE_MAILER_SOURCE_ID=21580
# Optional integer leadsource field in post body (only if Shape requires it beyond URL)
# SHAPE_MAILER_LEADSOURCE=
# Default Shape + Supabase status for new QuestMail / mailer CSV imports
# MAILER_IMPORT_STATUS=Dormant
# SHAPE_MAILER_DEFAULT_STATUS=Dormant

# Signed session cookie for inbound login (generate a long random string)
AUTH_SESSION_SECRET=

# Who can access /mailer-import/, /shape-archive/, and /chat/ (comma-separated)
# INBOUND_ADMIN_EMAILS=arashid@questrock.com,nikksmith@questrock.com

# Archive chat — max leads retrieved per question (default 12)
# ARCHIVE_CHAT_LEAD_LIMIT=12

# Shape bulk lead archive — default sources (JSON array or comma-separated)
# SHAPE_ARCHIVE_SOURCES=["Inbound Zoom Call","Inbound Shape Phone"]
# SHAPE_BULK_EXPORT_URL=https://secure.setshape.com/api/leads/bulk/export

# Shape owner for new mailer imports (Concierge desk)
SHAPE_CONCIERGE_USER_ID=31
# MAILER_CONCIERGE_LO_NAME=Concierge

# LO desk — this week's mail PDFs + label (or use mailer_campaigns.mail_documents in Supabase)
# MAILER_CURRENT_WEEK_LABEL=June 11, 2026 — QuestMail
# MAILER_CURRENT_WEEK_PDF_URL=https://your-storage.example.com/single-letter.pdf
# MAILER_MAIL_DOCUMENTS_JSON=[{"label":"Letter 1 — FHA Cash Out","pdf_url":"/mailer-mail/06112026/letter-1-fha-cash-out.pdf"}]

# Vercel cron auth for /api/shape-lead-sync (set same value on Vercel; cron sends Authorization: Bearer)
CRON_SECRET=

# Shape Lead Tracker — exclude noisy sources from 15-min sync (JSON array or comma-separated)
# SHAPE_TRACKER_EXCLUDED_SOURCES=Mail,Referral Partner(s),Contact,zWebLead - VISIT

# Optional: require Zapier to send this in x-zapier-secret header
ZAPIER_WEBHOOK_SECRET=

# Set to 1 during Call Tracker / QuestMail backfill to block Zapier + Resend (no LO or admin emails)
# SKIP_OUTBOUND_EMAIL=1

# ── Email webhooks (Zapier Catch Hook → Microsoft Outlook Send Email) ──────────
# ONE Zap, TWO emails on the same hook URL:
#   1. lo_disposition  — call answered → LO email with status buttons (email_to = LO)
#   2. lo_note_admin   — LO submits note → sam + CC arashid/nikk (email_to + email_cc)
#
# Zapier map from trigger root fields (NOT querystring):
#   To=email_to, CC=email_cc, Subject=email_subject, Body=email_html (HTML on), From=email_from_display
# email_phase: lo_disposition (LO buttons) | lo_note_admin (sam + CC after LO note)
# Create a NEW Catch Hook if the old ujttkak URL returns 404.
ZAPIER_EMAIL_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/12042550/ujttkak/

# 2. LO disposition portal → quest-rock-disposition.vercel.app → /api/disposition-record here
#    (Call Tracker + Shape sync + admin email). No separate status/note Zaps needed.

# Optional: separate hook for AI admin outcomes / reconcile (falls back to ZAPIER_EMAIL_WEBHOOK_URL)
# ZAPIER_ADMIN_NOTIFY_WEBHOOK_URL=

# Admin email when LO submits disposition NOTE (status-only click does not email admins)
# DISPOSITION_NOTIFY_EMAIL=sam@questrock.com
# DISPOSITION_NOTIFY_CC=arashid@questrock.com,nikksmith@questrock.com

# Optional Shape custom field for Help Requested (purple button)
# SHAPE_LAUNCH_HELP_FIELD=
# RESEND_API_KEY=
# EMAIL_FROM=QuestRock <notifications@questrock.com>

ADMIN_NOTIFICATION_EMAIL=arashid@questrock.com
ADMIN_NOTIFICATION_CC=nikksmith@questrock.com
