SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Central Hub SSO — QR Dashboard Supabase (validates hub access tokens)
HUB_SUPABASE_URL=https://your-qr-dashboard-project.supabase.co
HUB_SUPABASE_ANON_KEY=your-qr-dashboard-anon-key

OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
AI_MIN_FIELD_CONFIDENCE=0.55

# Shape CRM OpenAPI key (transcript sync + mailer LO assignment via depursLo)
SHAPE_API_KEY=64df4510e6f9258319905eaa4b9d53d04da019e20652765fab67b835d8cdac88
SHAPE_CRM_ID=20931
# Shape CRM lead editor URL (Open in Shape button on LO desk)
# SHAPE_PROSPECT_BASE_URL=https://secure.setshape.com/prospects
# SHAPE_UPDATE_URL=https://secure-api.setshape.com/api/update/lead/info
# Optional JSON override for LO roster (Vercel: SHAPE_LO_ROSTER_JSON). When set, replaces defaults below.
# SHAPE_LO_ROSTER_JSON=[{"name":"Tashawna Chisholm","depursLo":49},{"name":"Stephen Curry","depursLo":40},{"name":"Jessica Sherard","depursLo":37},{"name":"Tyler Johnson","depursLo":34},{"name":"Bastian Johnston","depursLo":13},{"name":"Nikk Smith","depursLo":3},{"name":"Gregory Bethea Jr","depursLo":58},{"name":"Zachary Davis","depursLo":55},{"name":"Jason Friday","depursLo":52},{"name":"Concierge","depursLo":31}]
# Inbound Zoom /api/zoom-transcript — opt-in Shape search + status update (default off)
# Safe to set SHAPE_API_KEY for mailer testing while this stays false
SHAPE_TRANSCRIPT_SYNC_ENABLED=false
# Thursday mailer import — Shape Marketing Source "Mail" (not Inbound Zoom Phone)
# Post URL: Settings → Sales & Marketing → Marketing Sources → Mail
SHAPE_POST_LEAD_URL=https://secure-api.setshape.com/postlead/20931/21580
# URL path source id (21580) if SHAPE_POST_LEAD_URL is unset:
SHAPE_MAILER_SOURCE_ID=21580
# Optional integer leadsource field in post body (only if Shape requires it beyond URL)
# SHAPE_MAILER_LEADSOURCE=
# Default Shape status for new mailer leads
# SHAPE_MAILER_DEFAULT_STATUS=New Lead

# Signed session cookie for inbound login (generate a long random string)
AUTH_SESSION_SECRET=

# Who can access /mailer-import/, /shape-archive/, and /chat/ (comma-separated)
# INBOUND_ADMIN_EMAILS=arashid@questrock.com,nikksmith@questrock.com

# Archive chat — max leads retrieved per question (default 12)
# ARCHIVE_CHAT_LEAD_LIMIT=12

# Shape bulk lead archive — default sources (JSON array or comma-separated)
# SHAPE_ARCHIVE_SOURCES=["Inbound Zoom Call","Inbound Shape Phone"]
# SHAPE_BULK_EXPORT_URL=https://secure.setshape.com/api/leads/bulk/export

# Shape owner for new mailer imports (Concierge desk)
SHAPE_CONCIERGE_USER_ID=31
# MAILER_CONCIERGE_LO_NAME=Concierge

# LO desk — this week's mail PDFs + label (or use mailer_campaigns.mail_documents in Supabase)
# MAILER_CURRENT_WEEK_LABEL=June 11, 2026 — QuestMail
# MAILER_CURRENT_WEEK_PDF_URL=https://your-storage.example.com/single-letter.pdf
# MAILER_MAIL_DOCUMENTS_JSON=[{"label":"Letter 1 — FHA Cash Out","pdf_url":"/mailer-mail/06112026/letter-1-fha-cash-out.pdf"}]

# Optional: require Zapier to send this in x-zapier-secret header
ZAPIER_WEBHOOK_SECRET=

# Returned in /api/zoom-transcript notification object (sync mode) or admin notify webhook (async)
ADMIN_NOTIFICATION_EMAIL=sam@questrock.com
ADMIN_NOTIFICATION_CC=nikksmith@questrock.com

# Async transcript processing: POST admin email payload here when AI finishes (Zapier Catch Hook URL)
ZAPIER_ADMIN_NOTIFY_WEBHOOK_URL=
