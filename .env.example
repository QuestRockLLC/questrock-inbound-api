# QUESTMAIL_WEEKLY_REPORT_CC=
# QUESTMAIL_REPORT_BASE_URL=https://questrock-inbound-api.vercel.app/questmail-report/
MAILER_RECONCILE_ALERT_EMAIL=arashid@questrock.com
MAILER_RECONCILE_ALERT_CC=nikksmith@questrock.com

