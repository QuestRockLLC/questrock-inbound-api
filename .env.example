# Per-app Zoom webhook secrets (Option B)
# ZOOM_WEBHOOK_SECRET_CALL=
# ZOOM_WEBHOOK_SECRET_RECORDING=
# ZOOM_WEBHOOK_SECRET_TRANSCRIPT=
#
# Server-to-Server OAuth — same Account ID for all apps; client id + secret must be a matched pair per app.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID_TRANSCRIPT=          # PixelShapeFlowTranscript
# ZOOM_CLIENT_SECRET_TRANSCRIPT=
# ZOOM_CLIENT_ID_RECORDING=           # PixelShapeFlowRecordingUrl
# ZOOM_CLIENT_SECRET_RECORDING=
# ZOOM_CLIENT_ID_CALL=                # Zoom Call to Shape - Arsalan
# ZOOM_CLIENT_SECRET_CALL=
# Optional legacy single-app fallback:
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# Async transcript processing: optional separate admin hook (prefer ZAPIER_EMAIL_WEBHOOK_URL)
# ZAPIER_ADMIN_NOTIFY_WEBHOOK_URL=
