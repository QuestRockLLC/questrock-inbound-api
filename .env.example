SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini
AI_MIN_FIELD_CONFIDENCE=0.55

# Shape CRM OpenAPI key (used only when inbound transcript sync is enabled below)
SHAPE_API_KEY=your-shape-api-key
SHAPE_CRM_ID=20931
# Inbound Zoom /api/zoom-transcript — opt-in Shape search + status update (default off)
# Safe to set SHAPE_API_KEY for mailer testing while this stays false
SHAPE_TRANSCRIPT_SYNC_ENABLED=false
# Thursday mailer import — Shape Marketing Source "Mail" (not Inbound Zoom Phone)
# Post URL: Settings → Sales & Marketing → Marketing Sources → Mail
SHAPE_POST_LEAD_URL=https://secure-api.setshape.com/postlead/20931/21580
# URL path source id (21580) if SHAPE_POST_LEAD_URL is unset:
SHAPE_MAILER_SOURCE_ID=21580
# Optional integer leadsource field in post body (only if Shape requires it beyond URL)
# SHAPE_MAILER_LEADSOURCE=
# Default Shape status for new mailer leads
# SHAPE_MAILER_DEFAULT_STATUS=Not Contacted

# Password for /mailer-import/ and /mailer-lo/ (same secret)
MAILER_IMPORT_SECRET=

# LO desk — this week's mail PDF + label (or use mailer_campaigns table in Supabase)
# MAILER_CURRENT_WEEK_LABEL=June 2026 Week 1
# MAILER_CURRENT_WEEK_PDF_URL=https://your-storage.example.com/mail-piece-june-2026.pdf

# Optional: require Zapier to send this in x-zapier-secret header
ZAPIER_WEBHOOK_SECRET=

# Returned in /api/zoom-transcript notification object (sync mode) or admin notify webhook (async)
ADMIN_NOTIFICATION_EMAIL=sam@questrock.com
ADMIN_NOTIFICATION_CC=nikksmith@questrock.com

# Async transcript processing: POST admin email payload here when AI finishes (Zapier Catch Hook URL)
ZAPIER_ADMIN_NOTIFY_WEBHOOK_URL=
